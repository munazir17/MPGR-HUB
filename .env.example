NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=2e1123b09e786a59f1af6b27668fda6a
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# --- Game Rewards Module (server-only) --------------------------------
# See docs/GAME_REWARDS_SETUP.md for the full one-time setup checklist.

# Vercel KV (Upstash Redis) — provisioned via the Vercel dashboard
# (Storage -> Create Database -> KV). These are populated automatically
# when the KV store is linked to this project; listed here only so local
# dev / other hosts know what's required.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Private key of the wallet that will be granted rewardManager status on
# the deployed MPGRRewardVault (0xbe4B0e8692670229129562a50A62f5173E30937C,
# Base Mainnet). NEVER prefix this with NEXT_PUBLIC_. Generate a dedicated
# key for this purpose — do not reuse an existing hot wallet.
REWARD_MANAGER_PRIVATE_KEY=

# Optional server-only Base RPC URL (falls back to
# NEXT_PUBLIC_BASE_RPC_URL if unset). Use a private/authenticated RPC
# endpoint in production for reliability.
BASE_RPC_URL=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when
# calling /api/games/mpgr-run/settlement. Generate with e.g.
# `openssl rand -hex 32`. Required — the settlement route refuses to run
# without it configured.
CRON_SECRET=
