NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=2e1123b09e786a59f1af6b27668fda6a
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# --- Game Rewards Module (server-only) --------------------------------
# See docs/GAME_REWARDS_SETUP.md for the full one-time setup checklist.

# Vercel KV (Upstash Redis) — provisioned via the Vercel dashboard
# (Storage -> Create Database -> KV). These are populated automatically
# when the KV store is linked to this project; listed here only so local
# dev / other hosts know what's required.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Private key of the wallet that will be granted rewardManager status on
# the deployed MPGRRewardVault (0xbe4B0e8692670229129562a50A62f5173E30937C,
# Base Mainnet). NEVER prefix this with NEXT_PUBLIC_. Generate a dedicated
# key for this purpose — do not reuse an existing hot wallet.
REWARD_MANAGER_PRIVATE_KEY=

# Optional server-only Base RPC URL (falls back to
# NEXT_PUBLIC_BASE_RPC_URL if unset). Use a private/authenticated RPC
# endpoint in production for reliability. Alchemy free-tier CU limits
# make Basename + quote reads flaky — prefer a paid Base key.
BASE_RPC_URL=

# Optional Ethereum Mainnet RPC used only as a Basename fallback
# (CCIP-Read). Not required now that Basenames resolve on Base L2 first.
MAINNET_RPC_URL=

# Gemini is the default agent provider. Free-tier gemini-3.5-flash is
# ~20 generateContent calls/day; after that the agent falls back to
# local FAQ replies. Use a billed Google AI Studio / Vertex key.
GEMINI_API_KEY=
GEMINI_MODEL=

# NVIDIA NIM is Gemini's first network fallback, then OpenAI, then the
# on-device engine. Server-only — never prefix with NEXT_PUBLIC_.
# Hosted OpenAI-compatible API: https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when
# calling /api/games/mpgr-run/settlement. Generate with e.g.
# `openssl rand -hex 32`. Required — the settlement route refuses to run
# without it configured.
CRON_SECRET=


# --- Authentication / security ---------------------------------------
# Server-only HMAC secret used to sign short-lived wallet sessions.
# Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=
# Canonical browser origin used in the wallet sign-in message and CSRF Origin check.
# Required in production (VERCEL_ENV=production). Example: https://mpgrhub.xyz
# Vercel Preview (VERCEL_ENV=preview) may omit this — the request origin is used
# so same-origin POSTs still verify. Do not disable origin verification.
# Example: https://mpgr-hub.example
APP_ORIGIN=

# Real-value game rewards remain disabled until authoritative game
# verification is deployed and reviewed.
GAME_REWARDS_ENABLED=false

# Independent server-side verifier for competitive game runs. Required before financial rewards can be enabled.
GAME_RUN_VERIFIER_URL=
GAME_RUN_VERIFIER_SECRET=
GAME_AUTHORITATIVE_VERIFICATION_ENABLED=false
